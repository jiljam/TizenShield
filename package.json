{
  "name": "tizenshield",
  "appName": "TizenShield",
  "version": "0.3.0",
  "description": "A remote-friendly web browser with ad hiding and a hardware video player for Samsung Tizen TVs, as a TizenBrew module.",
  "packageType": "mods",
  "websiteURL": "http://127.0.0.1:8081/module/gh%2Fjiljam%2FTizenShield/dist/start.html",
  "main": "dist/userScript.js",
  "keys": [
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "acorn": "^8.15.0",
    "esbuild": "^0.28.2"
  }
}
